#!/usr/bin/env bash
# test-zs — zskills smoke tests (static, no runtime deps)
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
SKILLS=("zasset" "zapply" "zarchitect" "zdash" "zdesign" "zdocs" "zpush" "ztest" "zverify")
PASS=0
FAIL=0
TOTAL=0

say() { printf '%s\n' "$*"; }
ok()  { PASS=$((PASS+1)); TOTAL=$((TOTAL+1)); say "  ✔ $1"; }
bad() { FAIL=$((FAIL+1)); TOTAL=$((TOTAL+1)); say "  ✘ $1"; }
info(){ say "  ℹ $1"; }

# ---------- helpers ----------
has_frontmatter() {
  local file="$1"
  local first
  first=$(head -n1 "$file")
  if [[ "$first" != "---" ]]; then return 1; fi
  # look for closing --- on a line by itself after line 1
  if tail -n +2 "$file" | grep -q "^---$"; then
    return 0
  else
    return 1
  fi
}

yaml_val() {
  # extract top-level key value from frontmatter (simple regex)
  local file="$1" key="$2"
  awk -v k="$key" '
    BEGIN{found=0}
    /^---/{if(found){exit} else {found=1; next}}
    found && $0 ~ "^"k":[ \t]*"{
      sub(/^[^:]+:[ \t]*/, "")
      print
      exit
    }
  ' "$file"
}

# ---------- global checks ----------
say "== global checks =="
for f in skills/*/SKILL.md; do
  name=$(basename "$(dirname "$f")")
  if [[ -f "$f" ]]; then
    ok "SKILL.md exists: $name"
  else
    bad "SKILL.md missing: $name"
    continue
  fi
  if has_frontmatter "$f"; then
    ok "frontmatter present: $name"
  else
    bad "frontmatter missing: $name"
  fi
  # required fields
  for field in name icon description; do
    val=$(yaml_val "$f" "$field")
    if [[ -n "$val" ]]; then
      ok "$name/$field = $val"
    else
      bad "$name/$field missing"
    fi
  done
done

# ---------- skill-specific checks ----------
say ""
say "== skill-specific checks =="

for skill in "${SKILLS[@]}"; do
  say "[$skill]"
  dir="$ROOT/skills/$skill"
  f="$dir/SKILL.md"

  if [[ ! -f "$f" ]]; then
    bad "SKILL.md not found for skill in array: $skill"
    continue
  fi

  # 1. references exist if mentioned in SKILL.md
  if grep -qE 'references/[A-Za-z0-9_-]+\.md' "$f"; then
    while IFS= read -r ref; do
      path="$dir/$ref"
      if [[ -f "$path" ]]; then
        ok "reference exists: $ref"
      else
        bad "reference missing: $ref"
      fi
    done < <(grep -oE 'references/[A-Za-z0-9_-]+\.md' "$f" | sort -u)
  else
    info "no references/*.md mentioned"
  fi

  # 2. assets exist if mentioned in SKILL.md
  if grep -qE 'assets/[A-Za-z0-9_/.-]+' "$f"; then
    while IFS= read -r asset; do
      path="$dir/$asset"
      if [[ -f "$path" ]]; then
        ok "asset exists: $asset"
      else
        bad "asset missing: $asset"
      fi
    done < <(grep -oE 'assets/[A-Za-z0-9_/.-]+' "$f" | sort -u)
  else
    info "no assets/* mentioned"
  fi

  # 3. markdown structure (at least one ## heading)
  if grep -qE '^## ' "$f"; then
    ok "has ## heading"
  else
    bad "missing ## heading"
  fi

  # 4. skill-specific rules
  case "$skill" in
    zdash)
      if grep -q 'npx zdashboard@latest --dir' "$f"; then
        ok "zdashboard launch command present"
      else
        bad "zdashboard launch command missing"
      fi
      if grep -q 'exit 0' "$f"; then
        ok "reuse exit-0 semantics documented"
      else
        bad "reuse exit-0 semantics missing"
      fi
      if grep -q '\-\-restart' "$f"; then
        ok "--restart documented"
      else
        bad "--restart missing"
      fi
      if grep -qE '\.zdev/' "$f"; then
        ok ".zdev output convention documented"
      else
        bad ".zdev output convention missing"
      fi
      if grep -qE '不写任何数据|Pure launcher|唯一职责' "$f"; then
        ok "pure-launcher boundary stated"
      else
        bad "pure-launcher boundary missing"
      fi
      ;;
    zdesign)
      if grep -q 'zentao\|禅道' "$f"; then
        bad "zdesign must not mention ZenTao (禅道)"
      else
        ok "no ZenTao mention (zdesign)"
      fi
      if grep -q 'getdesign' "$f"; then
        ok "getdesign reference present"
      else
        bad "getdesign reference missing"
      fi
      if grep -qE '\.zdev/design/?["`/ ]' "$f"; then
        ok ".zdev/design output root present"
      else
        bad ".zdev/design output root missing"
      fi
      if grep -q 'diagram-design' "$f"; then
        ok "diagram-design routing present"
      else
        bad "diagram-design routing missing"
      fi
      if grep -q 'zasset' "$f"; then
        ok "graphic assets routed to zasset"
      else
        bad "zasset routing missing"
      fi
      if grep -qE 'diagram-basics|diagram-style-mapping|quality-checklist' "$f"; then
        ok "diagram references present"
      else
        bad "diagram references missing"
      fi
      ;;
    zasset)
      if grep -qE '\.zdev/design/assets' "$f"; then
        ok ".zdev/design/assets output root present"
      else
        bad ".zdev/design/assets output root missing"
      fi
      if grep -qE 'brands/' "$f"; then
        ok "shared brands/ source consumption present"
      else
        bad "brands/ source consumption missing"
      fi
      if grep -qE '临摹|原创性红线' "$f"; then
        ok "originality red-line (no brand cloning) present"
      else
        bad "originality red-line missing"
      fi
      if grep -qE '授权' "$f"; then
        ok "font licensing notice present"
      else
        bad "font licensing notice missing"
      fi
      if grep -qE '缩放测试|缩放到' "$f"; then
        ok "scaling gate mentioned"
      else
        bad "scaling gate missing"
      fi
      ;;
    zdocs)
      if grep -q 'docswriter' "$f"; then
        ok "docswriter delegation mentioned"
      else
        bad "docswriter delegation missing"
      fi
      if grep -q 'diagram-design' "$f"; then
        ok "diagram-design usage present"
      else
        bad "diagram-design usage missing"
      fi
      if grep -q 'zasset' "$f"; then
        ok "graphic assets sourced from zasset"
      else
        bad "zasset sourcing missing"
      fi
      if grep -q 'git commit' "$f"; then
        ok "commit+push delivery present"
      else
        bad "commit+push delivery missing"
      fi
      ;;
    zapply)
      if grep -qE 'route to zarchitect|路由.*zarchitect' "$f"; then
        ok "no-change-yet routing to zarchitect present"
      else
        bad "no-change-yet routing missing"
      fi
      if grep -q 'openspec validate' "$f"; then
        ok "openspec validate present (verify stage)"
      else
        bad "openspec validate missing"
      fi
      if grep -q 'openspec archive' "$f"; then
        ok "openspec archive present"
      else
        bad "openspec archive missing"
      fi
      if grep -q 'craftsman' "$f"; then
        ok "craftsman delegation mentioned"
      else
        bad "craftsman delegation missing"
      fi
      if grep -q 'references/craftsman-prompt.md' "$f"; then
        ok "craftsman-prompt.md referenced"
      else
        bad "craftsman-prompt.md not referenced"
      fi
      if grep -q 'references/code-reviewer-prompt.md' "$f"; then
        ok "code-reviewer-prompt.md referenced"
      else
        bad "code-reviewer-prompt.md not referenced"
      fi
      if grep -q 'blocker' "$f"; then
        ok "blocker gate mentioned"
      else
        bad "blocker gate missing"
      fi
      if grep -qE '不自动重试|用户决策' "$f"; then
        ok "no-auto-retry / user decision gate mentioned"
      else
        bad "no-auto-retry gate missing"
      fi
      if grep -q 'code-simplifier' "$f"; then
        ok "code-simplifier optional pass mentioned"
      else
        bad "code-simplifier pass missing"
      fi
      if grep -q '分支收尾' "$f"; then
        ok "branch cleanup (merge back) step present"
      else
        bad "branch cleanup step missing"
      fi
      if grep -q '后台执行' "$f"; then
        ok "background dispatch mentioned"
      else
        bad "background dispatch missing"
      fi
      if grep -q 'worktree' "$f"; then
        ok "git worktree isolation mentioned"
      else
        bad "git worktree isolation missing"
      fi
      ;;
  esac

  # 5. global conventions (all skills)
  if grep -qE '\-\-mode ' "$f"; then
    bad "--mode flag must not appear (zdashboard is mode-less now)"
  else
    ok "no --mode flag"
  fi
  if grep -qE '\.zgoal|\.zreview|\.zdesign/' "$f"; then
    bad "legacy dot-dir (.zgoal/.zreview/.zdesign) must be .zdev"
  else
    ok "no legacy dot-dir"
  fi
done

# ---------- launcher 归一(只有 zdash 允许内嵌启动命令) ----------
say ""
say "== launcher exclusivity =="
for skill in "${SKILLS[@]}"; do
  f="$ROOT/skills/$skill/SKILL.md"
  [[ -f "$f" ]] || continue
  if grep -q 'npx zdashboard@latest' "$f"; then
    if [[ "$skill" == "zdash" ]]; then
      ok "[$skill] is the sole launcher"
    else
      bad "[$skill] embeds launcher command (npx zdashboard belongs to zdash only)"
    fi
  else
    ok "[$skill] launcher-pure"
  fi
done

# ---------- summary ----------
say ""
say "== summary =="
say "total: $TOTAL | pass: $PASS | fail: $FAIL"
if [[ "$FAIL" -gt 0 ]]; then
  say "FAIL: $FAIL check(s) failed"
  exit 1
else
  say "ALL PASS"
  exit 0
fi
